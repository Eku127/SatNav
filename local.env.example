#!/usr/bin/env bash
# Optional machine-local settings for SatNav.
#
# Copy this file to .local/env.sh and uncomment only the values needed on the
# current machine:
#
#   mkdir -p .local
#   cp local.env.example .local/env.sh
#
# The destination is ignored by Git. Public scripts keep their existing
# defaults when no local file is present. Existing environment variables take
# precedence because every example below uses ${VAR:-fallback}.

# Conda. The scripts still support the existing CONDA_INIT and CONDA_ENV names.
# export SATNAV_CONDA_SH="${SATNAV_CONDA_SH:-/path/to/miniconda3/etc/profile.d/conda.sh}"
export SATNAV_CONDA_ENV="${SATNAV_CONDA_ENV:-satnav}"

# Optional local GloVe source used by scripts/quickstart_models.sh.
# export SATNAV_GLOVE_TXT="${SATNAV_GLOVE_TXT:-/path/to/glove.6B.50d.txt}"

# Optional experiment monitoring. Keep credentials only in this ignored file
# or in the process environment; never put them in tracked YAML files.
# export SWANLAB_WORKSPACE="${SWANLAB_WORKSPACE:-your-workspace}"
# export SWANLAB_WEBHOOK_URL="${SWANLAB_WEBHOOK_URL:-https://example.invalid/webhook}"
# export SWANLAB_SECRET="${SWANLAB_SECRET:-replace-me}"

# Model-specific paths and runtime settings belong in:
#   scripts/seq2seq/.local/env.sh
#   scripts/cma/.local/env.sh
# Copy the adjacent local.env.example file in each directory when needed.
