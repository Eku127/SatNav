include README.md
include LICENSE
include DATA_LICENSE.md
include NOTICE
include pyproject.toml
include requirements.txt
include run.py
include local.env.example

recursive-include configs *.yaml *.yml
include configs/benchmark/satnav_v0_1_val_seen.json
include configs/benchmark/satnav_v0_1_val_seen_smoke.json
include configs/benchmark/satnav_v0_1_val_unseen.json
include configs/benchmark/satnav_v0_1_val_unseen_smoke.json
recursive-include doc *.md
recursive-include environments *.yml
recursive-include examples *.py *.md
recursive-include scripts *.sh *.py *.example
recursive-include applications *.md *.txt *.yaml *.png
include applications/resources/map.tif
include applications/resources/satnav_example_episodes.json
recursive-include baselines *.py *.md *.txt *.yaml *.yml *.sh *.example LICENSE* NOTICE*
include baselines/vlm/navila/configs/zero2.json
include baselines/vlm/openfly/configs/zero2.json
include baselines/vlm/streamvln/configs/zero2.json
include baselines/vlm/uninavid/configs/zero1.json
recursive-include satnav *.png
recursive-include tests *.py

# Machine-local overlays and run artifacts may exist in a developer checkout,
# but must never enter an sdist (or a wheel built from that sdist).  Keep these
# exclusions after the broad recursive includes above.
prune .local
prune rebuttal
prune baselines/classic/.local
prune baselines/vlm/*/.local
prune baselines/vlm/*/results
prune scripts/*/.local
global-exclude local_*.yaml *.local.yaml
