#!/usr/bin/env bash
# Copy to baselines/vlm/openfly/.local/env.sh; never commit machine paths.
# Explicitly exported values win because every assignment uses ${VAR:-fallback}.
export OPENFLY_PYTHON="${OPENFLY_PYTHON:-/absolute/path/to/envs/satnav-openfly/bin/python}"

# HF snapshot for --backend continue; native run/checkpoints for scratch.
export OPENFLY_CONTINUE_MODEL="${OPENFLY_CONTINUE_MODEL:-/absolute/path/to/openfly-hf-checkpoint}"
export OPENFLY_NATIVE_RUN="${OPENFLY_NATIVE_RUN:-/absolute/path/to/openfly-native-run}"
export OPENFLY_PROCESSOR_PATH="${OPENFLY_PROCESSOR_PATH:-/absolute/path/to/openfly-processor-checkpoint}"
export OPENFLY_NATIVE_HF_CACHE_DIR="${OPENFLY_NATIVE_HF_CACHE_DIR:-/absolute/path/to/openfly-native-hf-cache}"

export SATNAV_OPENFLY_TRAIN_DATA="${SATNAV_OPENFLY_TRAIN_DATA:-/absolute/path/to/SatNav-v0.1/trajectory_data}"
export SATNAV_OPENFLY_TRAIN_EPISODES="${SATNAV_OPENFLY_TRAIN_EPISODES:-/absolute/path/to/SatNav-v0.1/episodes/train/all_episodes.json}"
_openfly_eval_episodes_default="/absolute/path/to/SatNav-v0.1/episodes/eval/{split}/all_episodes.json"
export SATNAV_OPENFLY_EVAL_EPISODES="${SATNAV_OPENFLY_EVAL_EPISODES:-${_openfly_eval_episodes_default}}"
export SATNAV_OPENFLY_SCENES_DIR="${SATNAV_OPENFLY_SCENES_DIR:-/absolute/path/to/SatNav-v0.1/scenes}"
export SATNAV_OPENFLY_OUTPUT="${SATNAV_OPENFLY_OUTPUT:-output/baselines/vlm/openfly}"

# Optional exact clean comparison checkout; runtime never imports it.
export OPENFLY_PLATFORM_REPO="${OPENFLY_PLATFORM_REPO:-/absolute/path/to/OpenFly-Platform}"
export CUDA_DEVICES="${CUDA_DEVICES:-0,1}"
unset _openfly_eval_episodes_default
