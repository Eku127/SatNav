#!/usr/bin/env bash
# Copy to baselines/vlm/streamvln/.local/env.sh (Git-ignored).  Explicitly
# exported values win because every assignment uses ${VAR:-fallback}.

export STREAMVLN_REPO="${STREAMVLN_REPO:-/path/to/StreamVLN}"
export STREAMVLN_PYTHON="${STREAMVLN_PYTHON:-/path/to/satnav-streamvln/bin/python}"
export STREAMVLN_MODEL_ROOT="${STREAMVLN_MODEL_ROOT:-/path/to/streamvln-models}"
export STREAMVLN_TOKENIZER_PATH="${STREAMVLN_TOKENIZER_PATH:-/path/to/LLaVA-Video-7B-Qwen2}"
export STREAMVLN_VISION_TOWER="${STREAMVLN_VISION_TOWER:-/path/to/siglip-so400m-patch14-384}"
export SATNAV_STREAMVLN_TRAIN_DATA="${SATNAV_STREAMVLN_TRAIN_DATA:-/path/to/trajectory_data}"
_streamvln_eval_episodes_default="/path/to/SatNav-v0.1/episodes/eval/{split}/all_episodes.json"
export SATNAV_STREAMVLN_EVAL_EPISODES="${SATNAV_STREAMVLN_EVAL_EPISODES:-${_streamvln_eval_episodes_default}}"
export SATNAV_STREAMVLN_SCENES_DIR="${SATNAV_STREAMVLN_SCENES_DIR:-/path/to/scenes}"
export SATNAV_STREAMVLN_OUTPUT="${SATNAV_STREAMVLN_OUTPUT:-output/baselines/vlm/streamvln}"
unset _streamvln_eval_episodes_default

# Optional local wheel; install it manually as described in README.md.
# export STREAMVLN_FLASH_ATTN_WHEEL="${STREAMVLN_FLASH_ATTN_WHEEL:-/path/to/flash_attn.whl}"
