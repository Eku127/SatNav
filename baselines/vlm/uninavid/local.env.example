# Copy to baselines/vlm/uninavid/.local/env.sh. An already exported shell value
# takes precedence.
export UNINAVID_REPO="${UNINAVID_REPO:-/absolute/path/to/clean/Uni-NaVid}"
export UNINAVID_MODEL_ROOT="${UNINAVID_MODEL_ROOT:-/absolute/path/to/uninavid-models}"
export UNINAVID_MODEL="${UNINAVID_MODEL:-/absolute/path/to/full/Uni-NaVid-checkpoint}"
export UNINAVID_EVA="${UNINAVID_EVA:-/absolute/path/to/eva_vit_g.pth}"
export UNINAVID_PROCESSOR="${UNINAVID_PROCESSOR:-${UNINAVID_REPO}/uninavid/processor/clip-patch14-224}"
export UNINAVID_PYTHON="${UNINAVID_PYTHON:-/absolute/path/to/conda/env/bin/python}"
export UNINAVID_FLASH_ATTN_WHEEL="${UNINAVID_FLASH_ATTN_WHEEL:-/absolute/path/to/matching/flash_attn.whl}"
export SATNAV_UNINAVID_TRAIN_DATA="${SATNAV_UNINAVID_TRAIN_DATA:-/absolute/path/to/SatNav-v0.1/trajectory_data}"
_uninavid_eval_episodes_default="/absolute/path/to/SatNav-v0.1/episodes/eval/{split}/all_episodes.json"
export SATNAV_UNINAVID_EVAL_EPISODES="${SATNAV_UNINAVID_EVAL_EPISODES:-${_uninavid_eval_episodes_default}}"
export SATNAV_UNINAVID_SCENES_DIR="${SATNAV_UNINAVID_SCENES_DIR:-/absolute/path/to/scenes}"
export SATNAV_UNINAVID_OUTPUT="${SATNAV_UNINAVID_OUTPUT:-output/baselines/vlm/uninavid}"
unset _uninavid_eval_episodes_default
