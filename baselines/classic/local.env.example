# Copy to baselines/classic/.local/env.sh.  The copy is Git-ignored.
# Explicit shell variables take precedence over values loaded from that file.

export SATNAV_DATA_ROOT="${SATNAV_DATA_ROOT:-/path/to/SatNav-v0.1}"
export SATNAV_SCENES_DIR="${SATNAV_SCENES_DIR:-/path/to/satnav_datasets/scenes}"
export SATNAV_TRAJECTORY_DATA="${SATNAV_TRAJECTORY_DATA:-${SATNAV_DATA_ROOT}/trajectory_data}"
export SATNAV_CLASSIC_OUTPUT="${SATNAV_CLASSIC_OUTPUT:-output/baselines/classic}"
export SATNAV_CONDA_ENV="${SATNAV_CONDA_ENV:-satnav}"

# Optional neural evaluation inputs.  Canonical Seq2Seq/CMA configs must match
# the checkpoint architecture and vocabulary exactly.
# export SATNAV_VOCAB_PATH="${SATNAV_VOCAB_PATH:-/path/to/satnav_v0_1_vocab.json}"
# export SATNAV_SEQ2SEQ_CHECKPOINT="${SATNAV_SEQ2SEQ_CHECKPOINT:-/path/to/seq2seq/best.pth}"
# export SATNAV_SEQ2SEQ_EVAL_CONFIG="${SATNAV_SEQ2SEQ_EVAL_CONFIG:-configs/local_seq2seq_eval.yaml}"
# export SATNAV_CMA_CHECKPOINT="${SATNAV_CMA_CHECKPOINT:-/path/to/cma/best.pth}"
# export SATNAV_CMA_EVAL_CONFIG="${SATNAV_CMA_EVAL_CONFIG:-configs/local_cma_eval.yaml}"

# Evaluation defaults.  Set kind=official for the full 500-step contract.
export SATNAV_BENCHMARK_KIND="${SATNAV_BENCHMARK_KIND:-smoke}"
export SATNAV_CLASSIC_SEED="${SATNAV_CLASSIC_SEED:-0}"
export SATNAV_CLASSIC_RESUME="${SATNAV_CLASSIC_RESUME:-true}"
# export CUDA_DEVICES="${CUDA_DEVICES:-0}"
